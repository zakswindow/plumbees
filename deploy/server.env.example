# Copy to /home/ec2-user/plumbees/.env on the server and fill in. Then: chmod 600 .env
# These are read at runtime. Never commit the real file.
SITE_URL=https://www.plumbees.co.uk
AWS_REGION=eu-west-2
SES_FROM="Plumbees <quotes@plumbees.co.uk>"
QUOTE_NOTIFY_TO=
QUOTE_REPLY_TO=
IDEALPOSTCODES_API_KEY=
TRUST_PROXY=1
